# Agentic Software Factory configuration
# Copy to .env and override as needed

FACTORY_NAME=agentic-software-factory
BASE_DIR=.factory
WORKTREES_DIR=.factory/worktrees
MAX_RETRIES=3

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

LOG_LEVEL=INFO
ENABLE_TRACING=true
OTLP_ENDPOINT=
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

GITHUB_TOKEN=
GITHUB_OWNER=
DEFAULT_BRANCH=main

HITL_AUTO_APPROVE=false
HITL_TIMEOUT_SECONDS=3600
